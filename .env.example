# Copy to .env.local for local builds, or set both in Vercel: Project Settings > Environment Variables.

# Formspree form ID (the part after /f/ in your form URL).
# Leave empty and the contact form falls back to opening the visitor's email app.
VITE_FORMSPREE_ID=your_form_id_here

# Full site URL with https:// and no trailing slash, e.g. https://example.com
# Drives the canonical tag, share image URLs, robots.txt and sitemap.xml.
# Leave empty and the canonical tag is skipped and robots.txt/sitemap.xml use a placeholder domain.
VITE_SITE_URL=
